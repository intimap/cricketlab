{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cricket Lab commentary content bank, schema 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "bank",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "const": "cricketlab-commentary-ordinary-v1"
    },
    "pack_version": {
      "const": "1.0.0"
    },
    "bank": {
      "enum": [
        "ball_calls",
        "commentator_lines",
        "match_context"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "speaker",
          "requires",
          "text",
          "repeat_group",
          "weight",
          "priority",
          "cooldown_balls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^clab\\.v1\\.[a-zA-Z0-9_.]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "enum": [
              "neutral",
              "bunnings",
              "lorry",
              "grog"
            ]
          },
          "requires": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^(rec|facts)\\.[a-zA-Z0-9_.]+$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "in": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "not_in": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "gte": {
                      "type": "number"
                    },
                    "gt": {
                      "type": "number"
                    },
                    "lte": {
                      "type": "number"
                    },
                    "lt": {
                      "type": "number"
                    },
                    "truthy": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "repeat_group": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cooldown_balls": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
